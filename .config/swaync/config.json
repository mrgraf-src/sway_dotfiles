{
  "positionX": "center",
  "positionY": "top",
  "layer": "overlay",
  "control-center-width": 400,
  "control-center-height": 400,
  "fit-to-screen": false,
  "cssPriority": "user",
  "notification-window-width": 400,
  "text-empty": " ",
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "widgets": [
    "mpris",
    "title",
    "volume",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Уведомления",
      "clear-all-button": true,
      "button-text": "Очистить"
    },
    "mpris": {
      "loop-carousel": false,
      "blacklist": ["playerctld"],
      "image-size": 80
    },
    "volume": {
      "label": "",
      "step": 5
    },
    "notifications": {
      "clear-button-text": "Очистить"
    }
  }
}
