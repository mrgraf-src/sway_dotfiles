[
    {
        // ==========================================
        // ПАНЕЛЬ ДЛЯ ЛЕВОГО МОНИТОРА (DP-2)
        // ==========================================
        "output": "DP-2",
        "height": 26,
        "spacing": 2,
        "modules-left": [
            "sway/workspaces",
            "sway/scratchpad",
            "mpris"
        ],
        "modules-center": [
            "clock"
        ],
        "modules-right": [
            "group/tray-group",
            "custom/layout",
            "pulseaudio",
            
            "cpu",
            "temperature",
            "memory",  

            "disk",
            "disk#media",      
        ],
        "memory": {
        "format": " RAM: {used:0.1f}G / {total:0.1f}G",
        "tooltip": false
        },
        "custom/layout": {
        "exec": "$HOME/.config/waybar/My_Scripts/layout_status.sh",
        "interval": 1,
        "tooltip": false
        },
        "group/tray-group": {
            "orientation": "inherit",
            "drawer": {
                "transition-duration": 500,
                "transition-left-to-right": false,
                "click-to-reveal": true
            },
            "modules": [
                "custom/tray-icon",
                "tray"
            ]
        },
        "custom/tray-icon": {
            "format": "  ",
            "tooltip": false
        },
        "cpu": {
        "format": " CPU:{usage}% ",
        "tooltip": false
        },
        "temperature": {
        // "thermal-zone": 2,
         "hwmon-path": "/sys/class/hwmon/hwmon3/temp1_input",
        "critical-threshold": 80,
        // "format-critical": "{temperatureC}°C {icon}",
        "format": " CPU: {temperatureC}°C "
        },
            "tray": {
        // "icon-size": 21,
        "spacing": 10,
        },
        "clock": {
            "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
            "format-alt": "{:%Y-%m-%d}"
        },
        "network": {
            "format-wifi": " {signalStrength}%",
            "format-ethernet": " Connected",
            "format-disconnected": "⚠ Disconnected",
            "tooltip-format": "{ifname} via {gwaddr} "
        },
        "pulseaudio": {
            "format": "{volume}% {icon} {format_source}",
            "format-muted": " {format_source}",
            "format-icons": {
                "headphone": "",
                "default": ["", "", ""]
            },
            "on-click": "pavucontrol"
        },
        "custom/power": {
            "format" : "⏻ ",
            "tooltip": false
        },
        "mpris": {
            "format": " {player_icon} {artist} - {title} {position}/{length}",
            "format-paused": " {status_icon} <i>{artist} - {title}</i> {position}/{length}",
            "tooltip": false,
            "max-length": 80,
            "interval": 1,
            "player-icons": {
                "default": "",
                "mpv": "",
                "spotify": ""
            },
            "status-icons": {
                "paused": ""
            }
        },
        "disk": {
        "interval": 30,
        "path": "/",
        "format": " / {free} ",
        "tooltip-format": "Корень ( / ): {used} использовано из {total} ({percentage_used}%)\nСвободно: {free}"
        },
        "disk#media": {
            "interval": 30,
            "path": "/mnt/media",  // Укажи свой реальный путь к медиа-хранилищу
            "format": " /mnt/media {free} ",
            "tooltip-format": "Медиа: {used} использовано из {total} ({percentage_used}%)\nСвободно: {free}"
        }      
    

    },
    {
        // ==========================================
        // ПАНЕЛЬ ДЛЯ ПРАВОГО МОНИТОРА (DP-1)
        // ==========================================
        "output": "DP-1",
        "height": 26,
        "spacing": 2,
        "modules-left": [
            "sway/workspaces"
        ],
        "modules-center": [
            "clock"
        ],
        "modules-right": [

        ],
        "idle_inhibitor": {
            "format": "{icon}",
            "format-icons": {
                "activated": "",
                "deactivated": ""
            }
        },
        "clock": {
            "format": "{:%H:%M}"
        },
        // ==========================================
        // {free} — сколько свободно (например, 1.2 TB)
        // {used} — сколько занято
        // {total} — общий объем диска
        // {percentage_used} — процент заполненности
        // {percentage_free} — процент свободного места
        // ==========================================




    }
]